{
  "name": "ceciliobot",
  "version": "1.0.0",
  "description": "Ceciliobot - Built For Those Who Dare",
  "main": "main.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "electron:dev": "set NODE_ENV=development && electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:win": "npm run build:frontend && electron-builder --win",
    "dist": "npm run build:win"
  },
  "build": {
    "appId": "com.ceciliobot.oscar",
    "productName": "ceciliobot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.19.0"
  }
}
